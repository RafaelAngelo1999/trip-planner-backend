    {
      "name": "Bookings",
      "item": [
        {
          "name": "Reservar Voo - João Silva",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Booking created successfully\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has booking data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.booking).to.have.property('pnr');",
                  "    pm.expect(jsonData.data.booking.status).to.eql('CONFIRMED');",
                  "});",
                  "",
                  "// Save PNR for future reference",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data.booking.pnr) {",
                  "    pm.environment.set(\"pnr\", jsonData.data.booking.pnr);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passenger\": {\n    \"first_name\": \"João\",\n    \"last_name\": \"Silva\",\n    \"email\": \"joao.silva@email.com\",\n    \"phone\": \"+5511999887766\",\n    \"date_of_birth\": \"1990-05-15\",\n    \"passport\": \"BR123456789\",\n    \"nationality\": \"Brazilian\"\n  },\n  \"flight_date\": \"2024-12-15\",\n  \"special_requests\": \"Assento próximo à janela, refeição vegetariana\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/flights/{{flight_id}}/book",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "flights",
                "{{flight_id}}",
                "book"
              ]
            }
          },
          "response": []
        },
